<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Aavija</AssemblyName>
    <RootNamespace>Aavija</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <ApplicationVersion>1.1.0.0</ApplicationVersion>
    <Platforms>x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure .NET MediaPipe bindings for hand tracking. -->
    <PackageReference Include="Mediapipe.Net" Version="1.0.0-alpha2" />
    <PackageReference Include="Google.Protobuf" Version="3.25.1" />
    <!-- mDNS / Bonjour browsing on Windows. -->
    <PackageReference Include="Zeroconf" Version="3.6.14" />
    <!-- GDI screenshot fallback; WGC will replace this for per-window capture. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
