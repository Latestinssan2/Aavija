<Window x:Class="Aavija.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aavija — Gesture AirDrop over Wi-Fi"
        Height="760" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Aavija (Windows native)" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Pairing + file sharing + screenshots" Margin="0,4,0,16" Foreground="Gray" />

            <TextBlock Text="Phone host" />
            <TextBox x:Name="HostBox" Text="192.168.1.10" Margin="0,0,0,8" />
            <TextBlock Text="Port" />
            <TextBox x:Name="PortBox" Text="0" Margin="0,0,0,8" />
            <TextBlock Text="PIN (shown on this PC)" />
            <TextBox x:Name="PinBox" Text="" Margin="0,0,0,8" />
            <TextBlock Text="Request id (any)" />
            <TextBox x:Name="RequestIdBox" Text="req1" Margin="0,0,0,12" />

            <TextBlock Text="Listener PIN (for incoming pairing)" />
            <TextBox x:Name="ListenerPinBox" Text="" Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,12">
                <Button Content="Start listener" Click="StartListener_Click" Margin="0,0,8,8" />
                <Button Content="Stop listener" Click="StopListener_Click" Margin="0,0,8,8" />
            </WrapPanel>

            <WrapPanel Margin="0,0,0,12">
                <Button Content="Pair" Click="Pair_Click" Margin="0,0,8,8" />
                <Button Content="Push file" Click="Push_Click" Margin="0,0,8,8" />
                <Button Content="Pull file" Click="Pull_Click" Margin="0,0,8,8" />
                <Button Content="Capture screen" Click="CaptureScreen_Click" Margin="0,0,8,8" />
                <Button Content="Capture window" Click="CaptureActiveWindow_Click" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
