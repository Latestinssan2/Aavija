<Window x:Class="Aavija.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aavija — Gesture AirDrop over Wi-Fi"
        Height="720" Width="460"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Aavija" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Windows native client (scaffold)" Margin="0,4,0,20" Foreground="Gray" />
            <Button Content="Capture screen (WGC)" Click="CaptureScreen_Click" Margin="0,0,0,10" />
            <Button Content="Capture active window (WGC)" Click="CaptureActiveWindow_Click" Margin="0,0,0,10" />
            <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
