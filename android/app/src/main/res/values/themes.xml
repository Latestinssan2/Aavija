<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash theme (Day / Light): Crisp white background with Aavija logo -->
    <style name="Theme.Aavija.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">350</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>
    <color name="splash_bg_light">#FFFFFF</color>
    <color name="splash_bg_dark">#080B11</color>
</resources>
