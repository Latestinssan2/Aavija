<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light splash: white background, black logo -->
    <style name="Theme.Aavija.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>
    <color name="splash_bg_light">#FFFFFF</color>
    <color name="splash_bg_dark">#000000</color>
</resources>
